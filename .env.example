# HeroIQ Python Backend — Environment Variables

# Database (shared PostgreSQL with Next.js backend)
DATABASE_URL=postgresql+asyncpg://heroiq:heroiq_password@localhost:5432/heroiq

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=heroiq-search

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Internal service-to-service auth — MUST match the same var on the Next.js app.
# This is what authenticates Next.js → Python calls (the tenant serial key is no
# longer used for auth). Empty = fail closed (all tenant-scoped calls rejected).
# Generate once with: openssl rand -hex 32
HEROIQ_INTERNAL_API_TOKEN=

# App
APP_VERSION=1.0.0
DEBUG=true

# Sentry (optional, leave empty to disable)
SENTRY_DSN=

# CORS — comma-separated list of allowed browser origins. Leave empty in production;
# all current callers are server-to-server and don't trigger CORS. Set only for browser-direct
# debugging, e.g. ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8082
ALLOWED_ORIGINS=
