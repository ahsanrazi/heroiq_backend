# HeroIQ Python Backend — Environment Variables

# Database (shared PostgreSQL with Next.js backend)
DATABASE_URL=postgresql+asyncpg://heroiq:heroiq_password@localhost:5432/heroiq

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=heroiq-search

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# App
APP_VERSION=1.0.0
DEBUG=true

# Sentry (optional, leave empty to disable)
SENTRY_DSN=
